{
  "manifest_version": 3,
  "name": "SPeCTRUM Pro - UM Academic Companion",
  "version": "1.0.2",
  "description": "All-in-one academic companion for Universiti Malaya SPeCTRUM: track deadlines, timetables, attendance, and course materials.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SPeCTRUM Pro - UM Academic Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "alarms",
    "notifications",
    "cookies"
  ],
  "commands": {
    "toggle-floating-panel": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Toggle SPeCTRUM Pro floating pinned panel"
    }
  },
  "host_permissions": [
    "*://spectrum.um.edu.my/*",
    "https://login.microsoftonline.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/content.js"
      ],
      "css": [
        "scripts/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "popup/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
